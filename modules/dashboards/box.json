{
 "uid": "dd-box",
 "title": "Box",
 "tags": [
  "dd"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "box",
    "label": "box",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "options": [],
    "refresh": 1,
    "includeAll": false,
    "multi": false
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Cores",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dd_box_cpu_cores",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Memory",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dd_box_memory_bytes",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Disks",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(dd_box_disk_bytes)",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Uptime",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - node_boot_time_seconds",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Failed units",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(node_systemd_unit_state{state=\"failed\"} == 1) or vector(0)",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "avx512",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dd_box_cpu_flag{flag=\"avx512f\"}",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   }
  },
  {
   "id": 7,
   "type": "table",
   "title": "What this box is",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dd_box_info",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     },
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "job": true,
       "instance": true
      }
     }
    }
   ]
  },
  {
   "id": 8,
   "type": "table",
   "title": "Disks",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dd_box_disk_bytes",
     "legendFormat": "{{device}} {{kind}} {{bus}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     },
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {},
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "box": true
      }
     }
    }
   ]
  },
  {
   "id": 9,
   "type": "table",
   "title": "GPU",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dd_box_gpu_info",
     "legendFormat": "{{name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     },
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "box": true
      }
     }
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "CPU busy",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100",
     "legendFormat": "busy",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Memory used",
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
     "legendFormat": "used",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Disk free",
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs|fuse.*|overlay\"}",
     "legendFormat": "{{mountpoint}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Disk IO",
   "gridPos": {
    "x": 12,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(node_disk_read_bytes_total[5m]) + rate(node_disk_written_bytes_total[5m])",
     "legendFormat": "{{device}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Network",
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*\"}[5m]) + rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*\"}[5m])",
     "legendFormat": "{{device}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Temperatures",
   "gridPos": {
    "x": 12,
    "y": 30,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_hwmon_temp_celsius",
     "legendFormat": "{{chip}} {{sensor}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Load",
   "gridPos": {
    "x": 0,
    "y": 38,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_load1",
     "legendFormat": "1m",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "Failed units",
   "gridPos": {
    "x": 12,
    "y": 38,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${box}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_systemd_unit_state{state=\"failed\"} == 1",
     "legendFormat": "{{name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${box}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  }
 ]
}