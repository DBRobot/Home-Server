{
  "uid": "dd-fleet",
  "title": "Fleet",
  "tags": [
    "dd"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Boxes up",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"node\"} == 1)",
          "legendFormat": "{{box}}",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Release counter",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dd_agent_counter",
          "legendFormat": "{{box}}",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Since last good backup",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 7,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - dd_backup_last_success_seconds",
          "legendFormat": "{{box}}",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed units",
      "gridPos": {
        "x": 17,
        "y": 0,
        "w": 7,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_systemd_units{state=\"failed\"}",
          "legendFormat": "{{box}}",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory in use",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "legendFormat": "{{box}}",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Root filesystem free",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}",
          "legendFormat": "{{box}}",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU busy",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg by (box) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "{{box}}",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
